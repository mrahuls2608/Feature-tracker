NODE_ENV=development
PORT=4000
# MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/featuretrack?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/featuretrack
# Redis (Upstash / Redis Cloud / ElastiCache): rediss://default:<password>@<host>:6379
REDIS_URL=redis://127.0.0.1:6379
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
ENCRYPTION_KEY=change-me-too
WEB_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
COOKIE_SECURE=false
RUN_WORKERS_INLINE=true
ALLOW_PRIVATE_WEBHOOKS=true
LOG_LEVEL=info
